def valid_parantheses(string):
    stack = []      # creates an empty stack to store encountered opening parantheses
    mapping = {
        ")":"(",
        "}":"{",
        "]":"["
    }

    for char in string:
        # check for opening parantheses
        if char in mapping.values():
            stack.append(char)

        elif char in mapping:
            if not stack:
                return False
            top = stack.pop()
            if top != mapping[char]:
                return False
            
    return len(stack) == 0

